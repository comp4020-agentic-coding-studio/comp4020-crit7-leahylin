---
import Congrats from "../../components/Congrats.astro";
import CoursePlanner from "../../components/CoursePlanner.astro";
import DegreeProgress from "../../components/DegreeProgress.astro";
import ProgressSummary from "../../components/ProgressSummary.astro";
import StudyPlan from "../../components/StudyPlan.astro";
import { plannerBlocks } from "../../lib/course-planner";
import {
  everySemester,
  getPlan,
  listCourses,
  listSpecialisations,
  planProgress,
  semesterOptions,
  studyPlanBySemester,
} from "../../lib/db";
import { expectedGraduation } from "../../lib/graduation";
import { degreeComplete, degreeOnTrack } from "../../lib/progress";
import "../../styles.css";

// One plan: its Course Planner, Study Plan and Degree Progress. This page
// loads the plan and lays the sections out; each section is a component in
// src/components, and the Course Planner's decisions live in
// src/lib/course-planner.ts.

const { slug } = Astro.params;
const plan = slug ? getPlan(slug) : undefined;
if (!plan) {
  return new Response("No such plan", { status: 404 });
}

const { progress, chosen, poolsByKey, specialisationIdByKey, levelFloorKeys, listKeys } =
  planProgress(plan);
const specialisations = listSpecialisations();

// The plan's semesters run from its intake (see semesterOptions).
const semesters = semesterOptions(plan.intake);
// Every semester, empty ones included, so a gap in the plan shows as a gap.
const byTerm = studyPlanBySemester(chosen);
const semesterGroups = everySemester(byTerm, plan.intake);

const blocks = plannerBlocks({
  requirements: progress.requirements,
  catalogue: listCourses(),
  chosenIds: new Set(chosen.map((item) => item.course.id)),
  poolsByKey,
  specialisationIdByKey,
  levelFloorKeys,
  listKeys,
  specialisationLabel: (id) => specialisations.find((s) => s.id === id)?.label,
});

// Every requirement met by completed courses alone: the degree is done.
const graduated = degreeComplete(progress);
// When the plan says the student finishes (see graduation.ts).
const graduation = expectedGraduation({
  complete: graduated,
  onTrack: degreeOnTrack(progress),
  groups: byTerm,
  intake: plan.intake,
});
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{plan.label} — ANU degree progress</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Plans</a>
      <a href="/readme/">About</a>
    </nav>
    <main data-plan={plan.slug}>
      <h1>{plan.label}</h1>
      {graduated && <Congrats completedUnits={progress.completedUnits} />}
      {/* The unit figures live in the progress summary just below; this
          line only says what the plan is being checked against. */}
      <p class="subtitle">
        Master of Computing (7706XMCOMP) · 2025 rules · starts {plan.intake}
      </p>

      <ProgressSummary progress={progress} graduated={graduated} />

      {/* The page is three long sections; these jump between them so a
          change in the planner doesn't mean scrolling to the bottom to see
          what it did to the progress. */}
      <ul class="jump" aria-label="On this page">
        <li><a href="#course-planner">Course Planner</a></li>
        <li><a href="#study-plan">Study Plan</a></li>
        <li><a href="#degree-progress">Degree Progress</a></li>
      </ul>

      <h2 id="course-planner">ANU Course Planner</h2>
      <p class="note">
        Browse the degree's own categories and add a course to your study plan
        from whichever one it belongs to.
      </p>
      <CoursePlanner
        plan={plan}
        blocks={blocks}
        specialisations={specialisations}
        specialisationModelled={progress.specialisationModelled}
        semesters={semesters}
      />

      <h2 id="study-plan">My Study Plan</h2>
      <StudyPlan plan={plan} semesterGroups={semesterGroups} empty={chosen.length === 0} />

      <h2 id="degree-progress">Degree Progress</h2>
      <DegreeProgress progress={progress} graduation={graduation} />
    </main>
    <script>
      // The form posts and redirects, so the submitting tab re-renders from
      // SQLite on its own. This stream is how OTHER tabs showing the same
      // plan find out. Re-rendering on the server keeps one source of truth
      // for the arithmetic rather than duplicating the engine in the browser.
      const slug = document.querySelector("main")?.getAttribute("data-plan");
      const source = new EventSource("/api/events");
      source.addEventListener("message", (event) => {
        try {
          if (JSON.parse(event.data).slug === slug) location.reload();
        } catch {
          /* a heartbeat or a malformed frame: nothing to do */
        }
      });
    </script>
  </body>
</html>
