---
// Degree Progress: the 96-unit total, then every requirement with its
// standing, and anything that counts toward nothing.
import type { PlanProgress, RequirementProgress } from "../lib/progress";

interface Props {
  progress: PlanProgress;
}
const { progress } = Astro.props;
const total = progress.requirements.find((r) => r.kind === "total");
const categories = progress.requirements.filter((r) => r.kind !== "total");

function verdict(r: RequirementProgress): string {
  if (r.kind === "cap") return r.violated ? "over the limit" : "within limit";
  if (r.satisfied) return "done";
  if (r.onTrack) return "on track";
  if (r.countedUnits > 0) return "started";
  return "not started";
}
---

{
  total && (
    <section
      aria-labelledby="req-total"
      class:list={[
        "bucket",
        "total-card",
        `is-${total.satisfied ? "done" : total.countedUnits > 0 ? "started" : "not-started"}`,
        { over: total.exceeded },
      ]}
    >
      <h3 id="req-total">{total.label}</h3>
      <p class="bar">
        <progress
          id="prog-total"
          value={Math.min(total.countedUnits, total.requiredUnits)}
          max={total.requiredUnits}
          aria-labelledby="req-total"
        />
        <span class="figure">
          {total.countedUnits} of {total.requiredUnits} units
        </span>
      </p>
      {total.exceeded && (
        <p class="warn">
          Over-planned by {total.excessUnits} units — the degree is{" "}
          {total.requiredUnits} units, so something here won't count.
        </p>
      )}
      {total.detail && (
        <details class="more">
          <summary>Details</summary>
          <p class="rule">{total.detail}</p>
        </details>
      )}
    </section>
  )
}
{
  categories.map((requirement) => (
    <section
      aria-labelledby={`req-${requirement.key}`}
      class:list={["bucket", `is-${verdict(requirement).replaceAll(" ", "-")}`]}
    >
      <h3 id={`req-${requirement.key}`}>
        {requirement.label}
        {requirement.kind === "floor" && (
          <span class="kindtag">minimum, not an allocation</span>
        )}
        {requirement.kind === "cap" && (
          <span class="kindtag">maximum — stay under this</span>
        )}
        <span
          class:list={[
            "verdict",
            verdict(requirement).replaceAll(" ", "-"),
          ]}
        >
          {verdict(requirement)}
        </span>
      </h3>
      <p class="bar">
        <progress
          value={Math.min(
            requirement.countedUnits,
            requirement.requiredUnits,
          )}
          max={requirement.requiredUnits}
          aria-labelledby={`req-${requirement.key}`}
        />
        <span class="figure">
          {requirement.completedUnits} completed
          {requirement.plannedUnits > 0 && (
            <> + {requirement.plannedUnits} planned</>
          )}{" "}
          of {requirement.requiredUnits} units
        </span>
      </p>
      {requirement.violated && (
        <p class="warn">
          Over this maximum by {requirement.excessUnits} units. The
          specialisation only allows {requirement.requiredUnits} units
          from this list, so some of these cannot count toward it.
        </p>
      )}
      {/* The headline (status, bar, figure) stays visible; the rule
          text and which courses are counting sit behind Details, since
          Course Planner already shows the rule and most readers only
          want to know where each requirement stands. */}
      <details class="more">
        <summary>Details</summary>
        {requirement.detail && <p class="rule">{requirement.detail}</p>}
        <p class="counting">
          {requirement.countedCodes.length > 0
            ? `Counting: ${requirement.countedCodes.join(", ")}`
            : "Nothing counting toward this yet."}
        </p>
        {
          /* The gap between what a rule could accept and what it was
             credited is exactly the units a tighter rule claimed first. */
          requirement.kind === "allocating" &&
            requirement.poolMatchedUnits > requirement.countedUnits && (
              <p class="elsewhere">
                {requirement.poolMatchedUnits - requirement.countedUnits}{" "}
                more matching units are counting toward another requirement.
              </p>
            )
        }
      </details>
    </section>
  ))
}

{
  progress.surplusUnits > 0 && (
    <section aria-labelledby="surplus" class="bucket">
      <h3 id="surplus">Not counting anywhere</h3>
      <p class="figure">
        {progress.surplusUnits} units: {progress.surplusCodes.join(", ")}
      </p>
      <p class="rule">
        Every requirement these could fill is already full. They still
        count toward the total and the 8000-level floor.
      </p>
    </section>
  )
}
